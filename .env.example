# Copy to .env (or set in your host's environment)
PORT=3000
# First admin account, created on startup if it doesn't exist
ADMIN_EMAIL=admin@pincity.app
ADMIN_PASSWORD=change-me
# Browser key for the Maps JavaScript API (restrict it to your domain). Optional:
# without it the user app falls back to OpenStreetMap tiles.
GOOGLE_MAPS_API_KEY=
# Server key for the Places API (New), used to find coordinates for imported
# Google Maps list items. Optional: without it, items without coordinates are
# flagged "needs location" for an admin to fix.
GOOGLE_PLACES_API_KEY=
# Postgres connection. On Netlify, Netlify DB sets NETLIFY_DATABASE_URL for you.
# Leave empty locally to use a built-in database stored in data/pglite.
DATABASE_URL=
