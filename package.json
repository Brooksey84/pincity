{
  "name": "pin-city",
  "version": "0.1.0",
  "private": true,
  "description": "Curated, team-reviewed city pins: admin backend + user app",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed:demo": "node --no-warnings scripts/seed-demo.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
